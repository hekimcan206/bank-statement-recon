{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Matching": {
    "DateWindowDays": 5,
    "GroupWindowDays": 15,
    "ReferenceWindowDays": 30,
    "AbsoluteTolerance": 25,
    "RelativeTolerance": 0.01,
    "FuzzyThreshold": 0.72,
    "AmbiguityMargin": 0.05
  },
  "WorkQueue": {
    "DefaultLeaseSeconds": 300,
    "MaxLeaseSeconds": 1800,
    "ManualTolerance": 100
  },
  "Api": {
    "Keys": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
