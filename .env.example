# Copy to .env to override. The demo works without it; every value below is a development-only default.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
# Shared key for the /api routes (header X-Api-Key). Comma-separate several keys to rotate.
API_KEYS=demo-key-dev-only
